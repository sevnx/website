---
import UiIcon, { type IconName } from './UiIcon.astro';

export interface Props {
  href: string;
  text: string;
  icon?: IconName;
}

const { href, text, icon } = Astro.props;
---

<a class="tui-link" href={href}>{icon && <><UiIcon name={icon} />{' '}</>}{text}</a>

<style>
  .tui-link {
    color: var(--foreground0);
    text-decoration: none;
    text-underline-offset: 0.3em;
    white-space: nowrap;
  }

  /* inline-block keeps the brackets out of the hover underline. */
  .tui-link::before,
  .tui-link::after {
    display: inline-block;
    color: var(--box-border-color);
  }

  .tui-link::before {
    content: '[';
  }

  .tui-link::after {
    content: ']';
  }

  .tui-link:hover {
    color: var(--theme-accent);
    text-decoration: underline;
  }
</style>
