---
import { pageLocale } from '@/i18n/locales';
const locale = pageLocale(Astro.currentLocale);
interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locale, {
      year: 'numeric',
      month: 'short',
      timeZone: 'UTC',
    })
  }
</time>
