---
import TechnologyIcon from './TechnologyIcon.astro';

const paths = {
  'chevron-left': 'M15 5 8 12l7 7',
  'chevron-right': 'm9 5 7 7-7 7',
  calendar: 'M5 4h14v17H5z M8 2v5 M16 2v5 M5 9h14',
  clock: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18 M12 7v5l3 2',
  compass: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18 M16 8l-3 5-5 3 3-5z',
  location: 'M12 21s7-7 7-12a7 7 0 0 0-14 0c0 5 7 12 7 12z M12 6a3 3 0 1 0 0 6 3 3 0 0 0 0-6',
  briefcase: 'M3 7h18v13H3z M8 7V3h8v4 M3 12l9 3 9-3 M12 12v5',
  'graduation-cap': 'm2 8 10-5 10 5-10 5z M6 10v7l6 3 6-3v-7 M22 8v9',
  star: 'm12 3 3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z',
};

export type IconName = keyof typeof paths | 'github';
interface Props { name: IconName; }
const { name } = Astro.props;
---

<span class="ui-icon" aria-hidden="true">
  {name === 'github' ? <TechnologyIcon icon="github" /> : (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path d={paths[name]} />
    </svg>
  )}
</span>

<style>
  .ui-icon { display:inline-flex; width:1em; height:1em; flex:none; vertical-align:-0.125em; }
  .ui-icon :global(svg) { display:block; width:100%; height:100%; }
</style>
