---
import { render, type CollectionEntry } from 'astro:content';
import SkillBadge from '@/components/badges/SkillBadge.astro';
import LocationBadge from '@/components/badges/LocationBadge.astro';
import EmploymentTypeBadge from '@/components/badges/EmploymentTypeBadge.astro';
import MarkdownContent from '@/components/ui/MarkdownContent.astro';
import CommitEntry from './CommitEntry.astro';
import { technologies } from '@/data/technologies';

export interface Props {
  experience: CollectionEntry<'experience'>;
}

const { experience } = Astro.props;
const { data } = experience;
const { Content } = await render(experience);
---

<CommitEntry startDate={data.startDate} endDate={data.endDate === 'Present' ? null : data.endDate}>
  <h2>{data.jobTitle} @ {data.company}</h2>
  <div class="badges">
    <LocationBadge location={data.location} />
    <EmploymentTypeBadge employmentType={data.employmentType} />
    {data.technologies.map((name) => <SkillBadge technology={technologies.find((t) => t.name === name)} />)}
  </div>
  <p class="summary">{data.shortDescription}</p>
  <div class="details"><MarkdownContent content={Content} /></div>
</CommitEntry>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1ch;
  }

  .summary {
    color: var(--foreground2);
  }

  /* MDX sections read as branches, bullets as added lines. */
  .details :global(h3) {
    color: var(--iris);
    margin-block: 0.25lh 0;
  }

  .details :global(h3::before) {
    content: '';
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-right: 1ch;
    vertical-align: -0.125em;
    background-color: currentColor;
    mask: url('../../assets/ui-icons/git-branch.svg') center / contain no-repeat;
  }

  /* Out-specifies MarkdownContent's `ul li::before`. */
  .details :global(.markdown-content ul li::before) {
    content: '+ ';
    color: var(--pine);
  }

  .details :global(li) {
    padding-left: 2ch;
    text-indent: -2ch;
  }
</style>
