---
import { m } from '@/paraglide/messages.js';
import { pageLocale } from '@/i18n/locales';
import type { CollectionEntry } from 'astro:content';
import FormattedTimeRange from '@/components/ui/FormattedTimeRange.astro';
import { technologies as allTechnologies } from '@/data/technologies';
import SkillBadge from '../badges/SkillBadge.astro';
import { projectHref } from '@/lib/projects';
const locale = pageLocale(Astro.currentLocale);

export interface Props {
  education: CollectionEntry<'education'>;
  projects: CollectionEntry<'project'>[];
}

const { education, projects: allProjects } = Astro.props;
const { data } = education;
const endDate = data.endDate === 'Present' ? null : data.endDate;

function getTech(name: string) {
  return allTechnologies.find((t) => t.name === name);
}

const linkedProjects = (data.projects ?? [])
  .map((project) => allProjects.find((p) => p.data.key === project))
  .filter((p): p is CollectionEntry<'project'> => p !== undefined);
---

<div>
  <div class="header">
    <h2>{data.degree} <span class="muted">@ {data.institution}</span></h2>
    <span class="muted">
      <FormattedTimeRange startDate={data.startDate} endDate={endDate} /> · {data.location}
    </span>
  </div>

  <ul>
    {
      (data.classwork?.length ?? 0) > 0 && (
        <li class="branch">
          <h3 class="branch-label">{m.classwork({}, { locale })}</h3>
          <ul class="branch-items">
            {data.classwork?.map((course) => {
              const name = typeof course === 'string' ? course : course.name;
              const techs = typeof course === 'string' ? [] : course.technologies.map(getTech).filter(Boolean);
              return (
                <li class="branch-item">
                  {name}
                  <div class="inline-techs">
                    {techs.map((tech) => (
                      <SkillBadge technology={tech} />
                    ))}
                  </div>
                </li>
              );
            })}
          </ul>
        </li>
      )
    }
    {linkedProjects.length > 0 && (
      <li class="branch">
        <h3 class="branch-label">{m.projects({}, { locale })}</h3>
        <ul class="branch-items">
          {linkedProjects.map((project) => (
            <li>
              <a href={projectHref(project.data.key, locale)} class="project-link">
                [[ {project.data.name} ]]
              </a>
              <span>- {project.data.shortDescription}</span>
            </li>
          ))}
        </ul>
      </li>
    )}
    {(data.highlights?.length ?? 0) > 0 && (
      <li class="branch">
        <h3 class="branch-label">{m.highlights({}, { locale })}</h3>
        <ul class="branch-items">
          {data.highlights!.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      </li>
    )}
  </ul>
</div>

<style>
  .header {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    column-gap: 2ch;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.25lh;
  }

  .muted {
    color: var(--foreground2);
  }

  .branch {
    position: relative;
    padding-left: 3ch;
    padding-bottom: 0.25lh;
  }

  .branch::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5lh;
    width: 2ch;
    border-top: 2px solid var(--border-color);
  }

  .branch-label {
    margin-bottom: 0.25lh;
  }

  .branch::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 2px solid var(--border-color);
  }

  .branch:last-child::after {
    bottom: auto;
    height: 0.5lh;
  }

  .branch-items {
    list-style: none;
    padding: 0;
    margin-left: 0ch;
  }

  .branch-items li {
    position: relative;
    padding-left: 3ch;
    padding-bottom: 0.25lh;
  }

  .branch-items li:last-child {
    padding-bottom: 0;
  }

  .branch-items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5lh;
    width: 2ch;
    border-top: 2px solid var(--border-color);
  }

  .branch-items li::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 2px solid var(--border-color);
  }

  .branch-items li:last-child::after {
    bottom: auto;
    height: 0.5lh;
  }

  .project-link {
    text-decoration: none;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  .branch-item {
    display: flex;
    flex-direction: row;
    gap: 1ch;
  }

  .inline-techs {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
  }
</style>
