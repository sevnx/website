---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import TuiLayout from '@/layouts/TuiLayout.astro';
import FormattedDate from '@/components/ui/FormattedDate.astro';
import { blogSlug } from '@/lib/blog';

interface Props { blog: CollectionEntry<'blog'>; }
const { blog } = Astro.props;
const { Content } = await render(blog);
const availableLocales = (await getCollection('blog'))
  .filter((entry) => blogSlug(entry) === blogSlug(blog))
  .map((entry) => entry.data.locale);
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />

<TuiLayout availableLocales={availableLocales}>
  <article class="post">
    <header class="post-header">
      <h1>{blog.data.title}</h1>
      <span class="post-date"><FormattedDate date={blog.data.publishedDate} /></span>
    </header>
    <div class="post-body">
      <Content />
    </div>
  </article>
</TuiLayout>

<style>
  .post {
    max-width: 72ch;
    margin: 0 auto;
  }

  /* Header matches the blog list: mono title, grey date on the right. */
  .post-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 3ch;
    padding-bottom: 1lh;
    border-bottom: 1px solid var(--box-border-color);
  }

  .post-header h1 {
    color: var(--foreground0);
    font-size: 1.15em;
  }

  .post-date {
    color: var(--foreground2);
    white-space: nowrap;
  }

  /* Prose reads in a serif; code stays monospace. WebTUI resets margins, so spacing is restored here. */
  .post-body {
    --prose-size: 17px;
    padding-top: 1lh;
    line-height: 1.75;
  }

  /* WebTUI sets the mono font and size on every element, so prose elements opt in to the serif one by one. */
  .post-body :global(:is(p, li, blockquote, em, strong, a)) {
    font-family: 'Lora', Georgia, serif;
    font-size: var(--prose-size);
  }

  .post-body :global(:is(p, ul, ol, blockquote, pre, figure)) {
    margin-block: 0 1.1em;
  }

  .post-body :global(:is(h2, h3)) {
    font-family: 'Commit Mono', monospace;
    color: var(--theme-accent);
    line-height: 1.4;
    margin-block: 1.8em 0.6em;
  }

  .post-body :global(h2) {
    font-size: 19px;
  }

  .post-body :global(h3) {
    font-size: 17px;
    color: var(--iris);
  }

  .post-body :global(:is(ul, ol)) {
    padding-left: 1.5em;
  }

  .post-body :global(ul) {
    list-style: disc;
  }

  .post-body :global(ol) {
    list-style: decimal;
  }

  .post-body :global(li::before) {
    content: none;
  }

  .post-body :global(li + li) {
    margin-top: 0.3em;
  }

  .post-body :global(a) {
    color: var(--theme-accent);
    text-underline-offset: 0.2em;
  }

  .post-body :global(blockquote) {
    padding-left: 1.2em;
    border-left: 2px solid var(--rose);
    color: var(--foreground2);
    font-style: italic;
  }

  .post-body :global(code) {
    font-family: 'Commit Mono', monospace;
    font-size: 14px;
  }

  .post-body :global(:not(pre) > code) {
    padding: 0.1em 0.4em;
    background: var(--overlay);
  }

  /* Shiki's rose-pine-dawn background matches the page, so its inline style is overridden to set blocks apart. */
  .post-body :global(pre) {
    padding: 1em 1.2em;
    overflow-x: auto;
    background: var(--overlay) !important;
    line-height: 1.6;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 700px) {
    .post-header {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25lh;
    }

    .post-body {
      --prose-size: 16px;
    }
  }
</style>
