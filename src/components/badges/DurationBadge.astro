---
import { pageLocale } from '@/i18n/locales';
import { formatDuration } from '@/lib/time';
import FormattedTimeRange from '@/components/ui/FormattedTimeRange.astro';
import UiIcon from '@/components/ui/UiIcon.astro';
const locale = pageLocale(Astro.currentLocale);

interface Props {
  startDate: Date;
  endDate: Date | null;
  withDuration: boolean;
}

const { startDate, endDate, withDuration } = Astro.props;
---

<span class="duration-badge" is-="badge">
  <UiIcon name="clock" />
  &nbsp;
  <FormattedTimeRange startDate={startDate} endDate={endDate} separator={'\u00a0-\u00a0'} />
  {withDuration && <span>&nbsp;({formatDuration(startDate, endDate, locale)})</span>}
</span>
