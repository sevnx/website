---
import { m } from '@/paraglide/messages.js';
import { pageLocale } from '@/i18n/locales';
import type { EmploymentType } from '@/types';
import UiIcon, { type IconName } from '@/components/ui/UiIcon.astro';
const locale = pageLocale(Astro.currentLocale);

export interface Props {
    employmentType: EmploymentType;
}

const { employmentType } = Astro.props;

const employmentTypeBadge = {
    'Full-time': 'briefcase',
    'Apprenticeship': 'graduation-cap',
} satisfies Record<EmploymentType, IconName>;

const employmentMessages = { 'Full-time': m.employment_full_time, Apprenticeship: m.employment_apprenticeship };

const employmentTypeLogo = employmentTypeBadge[employmentType];
---

<div is-="badge">
    <span><UiIcon name={employmentTypeLogo} /> {employmentMessages[employmentType]({}, { locale })}</span>
</div>
