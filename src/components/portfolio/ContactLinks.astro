---
import { m } from '@/paraglide/messages.js';
import { pageLocale } from '@/i18n/locales';
import TechnologyIcon from '@/components/ui/TechnologyIcon.astro';
import UiIcon from '@/components/ui/UiIcon.astro';
const locale = pageLocale(Astro.currentLocale);

const contacts = [
  { label: 'Discord', value: 'https://discord.com/users/463467074069594112', title: m.copy_discord({}, { locale }) },
  { label: 'Email', value: 'sevveryn.czykinowski@gmail.com', title: m.copy_email({}, { locale }) },
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Livvic:wght@400;500&display=swap" rel="stylesheet" />

<p class="reach-out">{m.reach_out({}, { locale })}</p>
<!-- Each button copies its value instead of navigating, then briefly confirms. -->
<div class="contact-links" data-copied-label={m.copied({}, { locale })}>
  {contacts.map(({ label, value, title }, index) => (
    <Fragment>
      {index > 0 && <span class="separator" aria-hidden="true">·</span>}
      <button type="button" data-copy={value} title={title} aria-label={title}>
        {label === 'Discord' ? <TechnologyIcon icon="discord" /> : <UiIcon name="mail" />}
        <span data-label aria-live="polite">{label}</span>
      </button>
    </Fragment>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.contact-links').forEach((root) => {
    const copiedLabel = root.dataset.copiedLabel ?? 'Copied';
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
      const label = button.querySelector<HTMLElement>('[data-label]');
      if (!label) return;
      const original = label.textContent ?? '';
      let timeout: number | undefined;
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        label.textContent = copiedLabel;
        button.dataset.copied = '';
        window.clearTimeout(timeout);
        timeout = window.setTimeout(() => {
          label.textContent = original;
          delete button.dataset.copied;
        }, 1500);
      });
    });
  });
</script>

<style>
  .reach-out {
    margin: 0 0 18px;
    font-family: 'Livvic', 'Trebuchet MS', sans-serif;
    font-size: 21px;
    font-weight: 500;
    text-align: center;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
  }

  .separator {
    color: #9893a5;
  }

  /* Matches the GitHub and LinkedIn links in the intro. */
  button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 16px;
    color: #b4637a;
    text-decoration: underline;
    text-underline-offset: 5px;
    cursor: pointer;
  }

  button :global(.technology-icon),
  button :global(.ui-icon) {
    width: 18px;
    height: 18px;
  }

  button[data-copied] {
    color: #286983;
    text-decoration: none;
  }
</style>
