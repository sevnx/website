---
import { m } from '@/paraglide/messages.js';
import { pageLocale } from '@/i18n/locales';
import PortfolioExplorer from './PortfolioExplorer.astro';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
const locale = pageLocale(Astro.currentLocale);
---
<main class="desk">
  <LanguageSwitcher />
  <section class="intro" id="intro"><h1>{m.greeting({}, { locale })}</h1><div class="roles" aria-label={m.work_education({}, { locale })}>
    <span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12a22 22 0 0 0 18 0M12 11v4" /></svg>{m.job({}, { locale })}</span>
    <span class="role-separator" aria-hidden="true"></span>
    <span><svg width="20" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5-10-5Zm4 2v6c4 3 8 3 12 0v-6M22 9v8" /></svg>{m.student({}, { locale })}</span>
  </div><nav aria-label={m.social_links({}, { locale })}>
    <a href="https://github.com/sevnx"><svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 .297a12 12 0 0 0-3.793 23.385c.6.111.82-.261.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.419-1.305.762-1.605-2.665-.303-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.524.117-3.176 0 0 1.008-.323 3.301 1.23A11.5 11.5 0 0 1 12 6.098c1.02.005 2.047.138 3.006.404 2.291-1.553 3.297-1.23 3.297-1.23.655 1.652.243 2.873.12 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.625-5.479 5.922.43.372.823 1.102.823 2.222v3.292c0 .319.216.694.825.576A12 12 0 0 0 12 .297Z" /></svg>GitHub</a>
    <a href="https://linkedin.com/in/sewerynczykinowski"><svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0Z" /></svg>LinkedIn</a>
  </nav></section>
  <section id="work" aria-label={m.explore_work({}, { locale })}><div class="invitation"><div><h2>{m.invitation({}, { locale })}</h2><p>{m.invitation_description({}, { locale })}</p></div></div><PortfolioExplorer /></section>
  <footer>© {new Date().getFullYear()} Seweryn Czykinowski</footer>
</main>
<style>
  .roles { display:flex; flex-wrap:wrap; align-items:center; gap:12px 18px; margin-bottom:24px; font-size:16px; line-height:1.6; }
  .roles > span:not(.role-separator) { display:inline-flex; align-items:center; gap:9px; }
  .roles svg { flex:none; color:#b4637a; }
  .role-separator { height:18px; width:1px; background:#d7827e; }
  #work { scroll-margin-top:24px; }
  @media(max-width:700px) { .roles { flex-direction:column; align-items:flex-start; gap:8px; font-size:14px; }.role-separator { display:none; } }

  .desk .intro nav a { color:#b4637a; display:inline-flex; align-items:center; gap:8px; }
  .desk .intro nav svg { width:18px; height:18px; fill:currentColor; flex:none; }
  .desk :global(:focus-visible) { outline-color:#907aa9; }

  .desk { background:#faf4ed; color:#575279; padding:30px max(24px,calc((100vw - 1120px)/2)) 24px; min-height:100dvh; display:flex; flex-direction:column; }.intro { padding:76px 0 63px; }h1 { font-size:clamp(48px,6.5vw,88px); line-height:1.05; letter-spacing:-.065em; font-weight:600; margin:0 0 25px; }.intro p { font-size:21px; line-height:1.55; margin:0 0 24px; }nav { display:flex; gap:26px; }a { color:inherit; text-underline-offset:5px; }h2 { font-size:25px; letter-spacing:-.7px; font-weight:500; margin:0 0 8px; }.invitation { display:flex; justify-content:space-between; align-items:end; gap:24px; margin-bottom:22px; }.invitation p { margin:0; font-size:16px; color:#575279; }footer { margin-top:auto; text-align:center; font-size:13px; color:#575279; padding-top:48px; }
  @media(max-width:650px) { .intro { padding:58px 0 45px; }.intro p { font-size:18px; }.invitation { display:block; }h2 { font-size:22px; } }
</style>
