---
import { m } from '@/paraglide/messages.js';
import { pageLocale } from '@/i18n/locales';
import SkillBadge from '@/components/badges/SkillBadge.astro';
import { technologies } from '@/data/technologies';
const locale = pageLocale(Astro.currentLocale);

const defaults = [
  {
    role: m.role_frontend({}, { locale }),
    tools: ['React', 'TanStack Start', 'Tailwind', 'Effect', 'Astro'],
  },
  {
    role: m.role_backend({}, { locale }),
    tools: ['TypeScript', 'Rust'],
  },
  {
    role: m.role_systems({}, { locale }),
    tools: ['C', 'C++', 'Rust'],
  },
  {
    role: m.role_database({}, { locale }),
    tools: ['Convex', 'PostgreSQL'],
  },
  {
    role: m.role_small_apps({}, { locale }),
    tools: ['Rust'],
  },
  {
    role: m.role_deployment({}, { locale }),
    tools: ['VPS', 'Cloudflare'],
  },
  {
    role: m.role_tools({}, { locale }),
    tools: ['Docker', 'Git'],
  },
  {
    role: m.role_ai({}, { locale }),
    tools: ['Codex', 'Claude Code', 'T3 Code'],
  },
];

const principles = [
  { title: m.principle_use_title({}, { locale }), text: m.principle_use_description({}, { locale }) },
  { title: m.principle_types_title({}, { locale }), text: m.principle_types_description({}, { locale }) },
  { title: m.principle_craft_title({}, { locale }), text: m.principle_craft_description({}, { locale }) },
];
---

<div class="stack-overview">
  <header class="stack-intro">
    <p>{m.stack_description({}, { locale })}</p>
  </header>

  <div class="stack-columns">
    <section aria-labelledby="stack-defaults">
      <h3 id="stack-defaults"><span aria-hidden="true">01 / </span>{m.stack_defaults({}, { locale })}</h3>
      <dl class="stack-defaults">
        {defaults.map(({ role, tools }) => (
          <div class="stack-row">
            <dt>{role}</dt>
            <dd>
              <div class="stack-tools">{tools.map(name => <SkillBadge technology={technologies.find(technology => technology.name === name)} />)}</div>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="stack-principles" aria-labelledby="stack-approach">
      <h3 id="stack-approach"><span aria-hidden="true">02 / </span>{m.stack_approach({}, { locale })}</h3>
      <div class="principles">
        {principles.map(({ title, text }) => (
          <article>
            <h4>{title}</h4>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</div>

<style>
  .stack-overview { display:grid; gap:1.5lh; padding-top:0.5lh; padding-bottom:4ch; }
  .stack-intro { display:grid; gap:0.5lh; max-width:82ch; }
  .stack-columns { display:grid; grid-template-columns:minmax(0, 1.4fr) minmax(0, 1fr); gap:4ch; }
  h3 { color:var(--foreground0); margin-bottom:0.75lh; }
  h3 span { color:var(--foreground2); }
  .stack-defaults { margin:0; }
  .stack-row { display:grid; grid-template-columns:12ch minmax(0, 1fr); gap:1ch; padding-block:0.75lh; border-top:1px solid var(--highlight-med); }
  .stack-row:last-child { padding-bottom:0; }
  dt { color:var(--pine); }
  dd { margin:0; min-width:0; display:grid; gap:0.35lh; }
  .stack-tools { display:flex; flex-wrap:wrap; gap:1ch; }
  .stack-principles { border-left:1px solid var(--highlight-med); padding-left:3ch; }
  .principles { display:grid; gap:1lh; padding-top:0.75lh; border-top:1px solid var(--highlight-med); }
  .principles article { display:grid; gap:0.35lh; }
  h4 { color:var(--iris); }
  @media(max-width:900px) {
    .stack-columns { grid-template-columns:minmax(0, 1fr); gap:1.5lh; }
    .stack-principles { border-left:0; padding-left:0; }
    .principles { grid-template-columns:repeat(2, minmax(0, 1fr)); gap:1lh 3ch; }
  }
  @media(max-width:500px) {
    .stack-row { grid-template-columns:minmax(0, 1fr); gap:0.35lh; }
    .principles { grid-template-columns:minmax(0, 1fr); }
  }
</style>
