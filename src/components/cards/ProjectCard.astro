---
import type { CollectionEntry } from 'astro:content';
import DurationBadge from '@/components/badges/DurationBadge.astro';
import SkillBadge from '@/components/badges/SkillBadge.astro';
import { technologies } from '@/data/technologies';

export interface Props {
  project: CollectionEntry<'project'>;
}

const { project } = Astro.props;
---

<div class="project-card" box-="square">
  <div class="header">
    <div class="header-title">
      <h2>## {project.data.name}</h2>
      <DurationBadge
        startDate={project.data.startDate}
        endDate={project.data.endDate === 'Present' ? null : project.data.endDate}
        withDuration={false}
      />
    </div>
  </div>
  <div box-="square" shear-="top">
    <div class="header">
      <span>Summary</span>
    </div>
    <div class="content">
      <span>{project.data.shortDescription}</span>
    </div>
  </div>
  <div box-="square" shear-="top">
    <div class="header">
      <span>Technologies</span>
    </div>
    <div class="content technology-list">
      {
        project.data.technologies.map((technology) => (
          <SkillBadge technology={technologies.find((t) => t.name === technology)} />
        ))
      }
    </div>
  </div>
  <div>
    {
      project.data.githubUrl && (
        <div box-="square" shear-="both" class="project-action">
          <a href={project.data.githubUrl} target="_blank" rel="noreferrer">
            <span>VIEW ON GITHUB</span>
          </a>
        </div>
      )
    }
    <div box-="square" shear-="both" class="project-action">
      <div class="header">
        <span>Left</span>
      </div>
      {(<a href={`/projects/${project.slug}`}>VIEW MORE</a>)}
      <div class="header">
        <span>Bottom</span>
      </div>
    </div>
    {
      project.data.websiteUrl && (
        <div box-="square" shear-="both" class="project-action">
          <a href={project.data.websiteUrl} target="_blank" rel="noreferrer">
            <span>WEBSITE</span>
          </a>
        </div>
      )
    }
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    align-items: stretch;
    padding: 2ch;
  }

  .project-card h2 {
    margin-bottom: 1ch;
  }

  .project-card .header-title {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .project-card .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
    justify-content: center;
  }

  .project-card .content {
    padding: 0lh 1ch;
  }

  .project-card .project-action {
    display: flex;
    flex: 1;
    justify-content: center;
    align-items: center;
    height: 3lh;
    margin-top: -0.5lh;
  }

  span {
    background-color: var(--background0);
    padding: 0 1ch;
  }
</style>
