---
import type { CollectionEntry } from 'astro:content';
import DurationBadge from '@/components/badges/DurationBadge.astro';
import SkillBadge from '@/components/badges/SkillBadge.astro';
import TuiLink from '@/components/ui/TuiLink.astro';
import { technologies } from '@/data/technologies';

export interface Props {
  project: CollectionEntry<'project'>;
}

const { project } = Astro.props;
---

<div class="project-card" box-="square">
  <div class="header">
    <div class="header-title">
      <h2>## {project.data.name}</h2>
      <DurationBadge
        startDate={project.data.startDate}
        endDate={project.data.endDate === 'Present' ? null : project.data.endDate}
        withDuration={false}
      />
    </div>
  </div>
  <span>{project.data.shortDescription}</span>
  <div class="separator" is-="separator"></div>
  <div class="technology-list">
    {
      project.data.technologies.map((technology) => (
        <SkillBadge technology={technologies.find((t) => t.name === technology)} />
      ))
    }
  </div>
  <div class="project-links">
    <TuiLink href={`/projects/${project.slug}`} text="View more" />
    {project.data.githubUrl && <TuiLink href={project.data.githubUrl} text=" GitHub" />}
    {project.data.websiteUrl && <TuiLink href={project.data.websiteUrl} text=" Website" />}
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    align-items: stretch;
    padding: 2ch;
  }

  .project-card h2 {
    margin-bottom: 1ch;
  }

  .project-card .header-title {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .project-card .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
    justify-content: center;
  }

  .project-card .content {
    padding: 0lh 1ch;
  }

  .project-card .project-links {
    margin-top: 1ch;
    display: flex;
    gap: 1ch;
    flex: 1;
    align-items: flex-end;
    justify-content: center;
  }

  span {
    background-color: var(--background0);
  }
</style>
