---
import type { CollectionEntry } from 'astro:content';
import DurationBadge from '@/components/badges/DurationBadge.astro';
import SkillBadge from '@/components/badges/SkillBadge.astro';
import { technologies } from '@/data/technologies';
import LocationBadge from '@/components/badges/LocationBadge.astro';
import EmploymentTypeBadge from '@/components/badges/EmploymentTypeBadge.astro';

export interface Props {
  experience: CollectionEntry<'experience'>;
}

const { experience } = Astro.props;

const contentHtml = experience.body.replace(/^-/gm, '*').replace(/^\*/gm, '∗').replace(/\n/g, '<br>');
---

<div class="experience-card" box-="square">
  <div class="header">
    <div class="header-title">
      <h2>## {experience.data.jobTitle} @ {experience.data.company}</h2>
      <DurationBadge
        startDate={experience.data.startDate}
        endDate={experience.data.endDate === 'Present' ? null : experience.data.endDate}
        withDuration={true}
      />
    </div>
    <div class="header-info">
      <LocationBadge location={experience.data.location} />
      <EmploymentTypeBadge employmentType={experience.data.employmentType} />
      {
        experience.data.technologies.map((technology) => (
          <SkillBadge technology={technologies.find((t) => t.name === technology)} />
        ))
      }
    </div>
  </div>
  <div class="header-description">
    <span>{experience.data.shortDescription}</span>
  </div>
  <div class="separator" is-="separator"></div>
  <div class="content">
    <span set:html={contentHtml} />
  </div>
</div>

<style>
  .experience-card {
    padding: 2ch;
  }

  .experience-card h2 {
    margin-bottom: 1ch;
  }

  .experience-card .header-title {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }

  .experience-card .header-info {
    margin-bottom: 1ch;
    display: flex;
    flex-direction: row;
    gap: 1ch;
  }

  .experience-card div[is-='separator'] {
    display: flex;
    flex-direction: column;
    --separator-color: var(--box-border-color);
    --separator-width: 1px;
  }
</style>
