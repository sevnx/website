---
import UiIcon from '@/components/ui/UiIcon.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!-- Sets one detail apart from the surrounding prose, with a title bar like a pane. -->
<aside class="callout">
  <div class="title"><UiIcon name="star" /> {title}</div>
  <div class="body"><slot /></div>
</aside>

<style>
  .callout { margin-block:1lh; border:1px solid var(--background3); }
  .title { padding-inline:1ch; background:var(--background2); color:var(--theme-accent); }
  .body { display:grid; gap:0.5lh; padding:0.5lh 1ch; }
  .body :global(pre) { margin:0; }
</style>
