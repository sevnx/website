---
import { m } from '@/paraglide/messages.js';
import { pageLocale } from '@/i18n/locales';
const locale = pageLocale(Astro.currentLocale);
---
<div class="project-table" role="region" aria-label={m.project_breakdown({}, { locale })} tabindex="0">
  <table><slot /></table>
</div>

<style>
  .project-table { max-width:100%; overflow-x:auto; margin-block:1lh; }
  table { width:100%; min-width:64ch; }
  table :global(:is(th, td)) { vertical-align:top; padding-inline-end:2ch; }
  table :global(th) { color:var(--rose); }
  table :global(:is(th, td):first-child:nth-last-child(2)) { width:16ch; }
  table :global(tr:has(> :nth-child(3):last-child) > :is(th, td)) { width:33.333%; }
  table :global(:is(th, td):last-child) { padding-inline-end:0; }
</style>
