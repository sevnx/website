---
import '@/styles/fonts.css';
import { m } from '@/paraglide/messages.js';
import { locales, pageLocale, type Locale } from '@/i18n/locales';
import { localizedHref } from '@/i18n/links';
const locale = pageLocale(Astro.currentLocale);

interface Props {
  title?: string;
  description?: string;
  availableLocales?: readonly Locale[];
}
const {
  title = m.page_title({}, { locale }),
  description = m.page_description({}, { locale }),
  availableLocales = locales,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {availableLocales.map((language) => <link rel="alternate" hreflang={language} href={new URL(localizedHref(Astro.url.pathname, language), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localizedHref(Astro.url.pathname, availableLocales.includes('en') ? 'en' : availableLocales[0] ?? locale), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/CommitMono.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
<style is:global>
  * { box-sizing:border-box; }
  html { color-scheme:light; background:#faf4ed; color:#575279; scroll-behavior:smooth; }
  body { margin:0; font-family:'Trebuchet MS','Avenir Next',sans-serif; }
  :focus-visible { outline:2px solid #907aa9; outline-offset:5px; }
  @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
</style>
