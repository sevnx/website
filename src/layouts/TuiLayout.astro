---
import type { AstroInstance } from 'astro';
import Layout from './Layout.astro';

export interface Props {
  name: string;
}

const { name } = Astro.props;

interface Section {
  name: string;
  url: string;
}

const sections: Section[] = [
  {
    name: 'Profile',
    url: '/',
  },
  {
    name: 'Experience',
    url: '/experience',
  },
  {
    name: 'Projects',
    url: '/projects',
  },
  {
    name: 'Skills',
    url: '/skills',
  },
  {
    name: 'Blog',
    url: '/blog',
  },
  {
    name: 'Stats',
    url: '/stats',
  },
  {
    name: 'Hobbies',
    url: '/hobbies',
  },
  {
    name: 'Contact',
    url: '/contact',
  },
];
---

<Layout>
  <div class="app">
    <aside class="sidebar">
      <div class="profile-card" box-="square" shear-="top">
        <div class="header">
          <span>Status</span>
        </div>
        <!-- Avatar -->
        <div></div>
        <!-- Name + Status -->
        <div class="me">
          <div>#</div>
          <div>#</div>
          <div>#</div>
          <div>#</div>
          <div>#</div>
          <div>#</div>
        </div>
      </div>
      <nav class="nav-menu" box-="square" shear-="top">
        <div class="header">
          <span>Sections</span>
        </div>
        <ul>
          {
            sections.map((page) => (
              <li class:list={{ active: page.name === name }}>
                <a href={page.url === '' ? '/' : page.url}>{page.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
    <main box-="square" shear-="top">
      <div class="header">
        <span>{name}</span>
      </div>
      <div class="content">
        <slot />
      </div>
    </main>
    <footer class="footer" box-="square">
      <span>Footer</span>
    </footer>
  </div>
</Layout>

<style>
  body {
    height: 100vh;
  }

  .header {
    display: flex;
    justify-content: space-between;
  }

  span {
    background-color: var(--background0);
    padding: 0 1ch;
  }

  .app {
    /* Grid display */
    display: grid;
    grid-template-columns: 32ch 1fr;
    grid-template-rows: 1fr 4ch;

    /* Padding / Gap */
    gap: 0ch 1ch;
    padding: 1ch;

    /* Size */
    height: 100%;

    /* Boxes */
    --box-border-color: #4c4f69;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
  }

  .nav-menu {
    flex: 1;
    overflow-y: auto;
  }

  .nav-menu li {
    padding: 0lh 1ch;
  }

  .nav-menu ul li:before {
    content: ' ';
  }

  .nav-menu ul li.active:before {
    color: inherit;
    content: '∗';
  }

  .nav-menu a {
    text-decoration: none;
    color: inherit;
  }

  .content {
    padding: 0lh 1ch;
  }

  .footer {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
