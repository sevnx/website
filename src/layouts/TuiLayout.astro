---
import PortfolioLayout from './PortfolioLayout.astro';
import WebTuiStyles from '@/components/portfolio/WebTuiStyles.astro';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import { m } from '@/paraglide/messages.js';
import { localizedHref } from '@/i18n/links';
import { pageLocale, type Locale } from '@/i18n/locales';
const locale = pageLocale(Astro.currentLocale);
interface Props { name: string; availableLocales?: readonly Locale[]; }
const { name, availableLocales } = Astro.props;
const backHref = localizedHref('/', locale);
---
<PortfolioLayout title={`${name} | Seweryn Czykinowski`} availableLocales={availableLocales}>
  <WebTuiStyles />
  <main class="detail-page">
    <LanguageSwitcher availableLocales={availableLocales} />
    <a class="back-link" href={backHref}>{m.back_portfolio({}, { locale })}</a>
    <div class="webtui-portfolio" data-webtui-theme="rose-pine-dawn">
      <div class="detail-content" box-="square"><slot /></div>
    </div>
    <footer>© {new Date().getFullYear()} Seweryn Czykinowski</footer>
  </main>
</PortfolioLayout>
<style>
  .detail-page { max-width:1120px; min-height:100dvh; margin:0 auto; padding:40px 24px 0; display:flex; flex-direction:column; }
  .back-link { margin-top:24px; align-self:flex-start; color:#b4637a; margin-bottom:24px; text-underline-offset:5px; }
  .detail-content { padding:2lh 3ch; min-width:0; overflow-wrap:anywhere; }
  footer { margin-top:auto; padding:40px 0 24px; text-align:center; font-size:13px; }
  @media(max-width:700px) { .detail-page { padding:24px 12px 0; }.detail-content { padding:1lh 2ch; } }
</style>
