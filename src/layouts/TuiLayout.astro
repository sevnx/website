---
import Layout from './Layout.astro';
import Footer from '@/components/Footer.astro';

export interface Props {
  name: string;
}

const { name } = Astro.props;

interface Section {
  name: string;
  url: string;
}

const sections: Section[] = [
  {
    name: 'Profile',
    url: '/',
  },
  {
    name: 'Experience',
    url: '/experience',
  },
  {
    name: 'Projects',
    url: '/projects',
  },
  {
    name: 'Skills',
    url: '/skills',
  },
  {
    name: 'Education',
    url: '/education',
  },
  {
    name: 'Blog',
    url: '/blog',
  },
  {
    name: 'Stats',
    url: '/stats',
  },
  {
    name: 'Hobbies',
    url: '/hobbies',
  },
];
---

<Layout>
  <div class="app">
    <aside class="sidebar">
      <div class="profile-card" box-="square" shear-="top">
        <div class="header">
          <span>Status</span>
        </div>
        <!-- Avatar -->
        <div></div>
        <!-- Name + Status -->
        <div class="me">
          <div>#</div>
          <div>#</div>
          <div>#</div>
          <div>#</div>
          <div>#</div>
          <div>#</div>
        </div>
      </div>
      <nav class="nav-menu" box-="square" shear-="top">
        <div class="header">
          <span>Sections</span>
        </div>
        <ul>
          {
            sections.map((page) => (
              <li class:list={{ active: page.name === name }}>
                <a href={page.url === '' ? '/' : page.url}>{page.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="contact-links" box-="square" shear-="top">
        <div class="header">
          <span>Contact & Links</span>
        </div>
        <div class="links">
          <div class="email">
            <dialog id="email-dialog" popover>
              <p>My email : <a href="mailto:sevveryn.czykinowski@gmail.com">sevveryn.czykinowski@gmail.com</a> </p>
              <div id="email-dialog-buttons">
                <button box-="round" onclick="document.getElementById('email-dialog').hidePopover()">Close</button>
              </div>
            </dialog>
            <button id="email-dialog-button" popovertarget="email-dialog"><span>>  Email </span></button>
          </div>
          <div class="social">
            <a href="https://linkedin.com/in/sewerynczykinowski" target="_blank">
              <span>>  LinkedIn</span>
            </a>
          </div>
          <div>
            <a href="https://github.com/sevnx" target="_blank">
              <span>>  GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </aside>
    <main box-="square" shear-="top">
      <div class="header">
        <span>{name}</span>
      </div>
      <div class="content">
        <slot />
      </div>
    </main>
    <Footer/>
  </div>
</Layout>

<style>
  body {
    height: 100vh;
  }

  .header {
    display: flex;
    justify-content: space-between;
  }

  span {
    background-color: var(--background0);
    padding: 0 1ch;
  }

  .app {
    /* Grid display */
    display: grid;
    grid-template-columns: 32ch 1fr;
    grid-template-rows: 1fr 4ch;

    /* Padding / Gap */
    gap: 0ch 1ch;
    padding: 1ch;

    /* Size */
    height: 100%;

    /* Boxes */
    --box-border-color: #4c4f69;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
  }

  .nav-menu {
    flex: 1;
    overflow-y: auto;
  }

  .nav-menu li {
    padding: 0lh 1ch;
  }

  .nav-menu ul li:before {
    content: ' ';
  }

  .nav-menu ul li.active:before {
    color: inherit;
    content: '∗';
  }

  .nav-menu a {
    text-decoration: none;
    color: inherit;
  }

  .contact-links a {
    text-decoration: none;
    color: var(--text);
  }

  #email-dialog-button {
    height: 1lh;
    color: var(--text);
    padding: 0;
  }

  .email dialog {
    padding: 1lh;
    border: 1px solid var(--box-border-color);
  }

  .email dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.5);
  }

  .content {
    padding: 0lh 1ch;
  }
</style>
