---
import Layout from './Layout.astro';
import Footer from '@/components/layout/Footer.astro';

export interface Props {
  name: string;
}

const { name } = Astro.props;

interface Section {
  name: string;
  url: string;
}

const sections: Section[] = [
  {
    name: 'Profile',
    url: '/',
  },
  {
    name: 'Experience',
    url: '/experience',
  },
  {
    name: 'Projects',
    url: '/projects',
  },
  {
    name: 'Education',
    url: '/education',
  },
  {
    name: 'Blog',
    url: '/blog',
  },
];
---

<Layout>
  <div class="app">
    <aside class="sidebar">
      <div class="profile-card" box-="square" shear-="top">
        <div class="header">
          <span>Status</span>
        </div>
        <div class="me">
          <div>
            <span>
              <img
                src="https://avatars.githubusercontent.com/u/115710692?s=400&u=61779faa8bcd9d3e60ca4de54ab8192b6cb77567&v=4"
                alt="GitHub Avatar"
              />
              Seweryn Czykinowski
            </span>
          </div>
          <div is-="separator"></div>
          <div>
            <span> SW Engineer @ Nokia</span>
          </div>
          <div>
            <span> Paris, France</span>
          </div>
        </div>
      </div>
      <nav class="nav-menu" box-="square" shear-="top">
        <div class="header">
          <span>Sections</span>
        </div>
        <ul>
          {
            sections.map((page) => (
              <li class:list={{ active: page.name === name }}>
                <a href={page.url === '' ? '/' : page.url}>{page.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="contact-links" box-="square" shear-="top">
        <div class="header">
          <span>Contact & Links</span>
        </div>
        <div class="links">
          <div class="contact">
            <dialog id="contact-dialog" popover>
              <form method="POST" action="" class="contact-form" box-="square" shear-="top">
                <div class="header">
                  <span>Message</span>
                </div>
                <div class="form-container">
                  <div box-="square" shear-="top">
                    <div class="header">
                      <span>Name</span>
                    </div>
                    <div class="form-content">
                      <input type="text" name="name" placeholder="Your name" required />
                    </div>
                  </div>
                  <div box-="square" shear-="top">
                    <div class="header">
                      <span>Subject</span>
                    </div>
                    <div class="form-content">
                      <input type="text" name="subject" placeholder="Your subject" required />
                    </div>
                  </div>
                  <div box-="square" shear-="top">
                    <div class="header">
                      <span>Content</span>
                    </div>
                    <div class="form-content">
                      <textarea name="content" placeholder="Your message..." maxlength="280" rows="6" required
                      ></textarea>
                    </div>
                  </div>
                  <div class="form-buttons">
                    <button type="button" box-="round" onclick="document.getElementById('contact-dialog').hidePopover()"
                      >Cancel</button
                    >
                    <button type="submit" box-="round">Send</button>
                  </div>
                </div>
              </form>
            </dialog>
            <button id="contact-dialog-button" popovertarget="contact-dialog"><span>>  Message</span></button>
          </div>
          <div class="social">
            <a href="https://linkedin.com/in/sewerynczykinowski" target="_blank">
              <span>>  LinkedIn</span>
            </a>
          </div>
          <div>
            <a href="https://github.com/sevnx" target="_blank">
              <span>>  GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </aside>
    <main box-="square" shear-="top">
      <div class="header">
        <span>{name}</span>
      </div>
      <div class="content">
        <slot />
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style>
  .profile-card img {
    display: inline-block;
    width: 2ch;
    vertical-align: middle;
  }

  body {
    height: 100vh;
  }

  .header {
    display: flex;
    justify-content: space-between;
  }

  span {
    background-color: var(--background0);
    padding: 0 1ch;
  }

  .app {
    /* Grid display */
    display: grid;
    grid-template-columns: 32ch 1fr;
    grid-template-rows: 1fr 4ch;

    /* Padding / Gap */
    gap: 0ch 1ch;
    padding: 1ch;

    /* Size */
    height: 100%;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
  }

  .nav-menu {
    flex: 1;
    overflow-y: auto;
  }

  .nav-menu li {
    padding: 0lh 1ch;
  }

  .nav-menu ul li:before {
    content: ' ';
  }

  .nav-menu ul li.active:before {
    color: inherit;
    content: '∗';
  }

  .nav-menu a {
    text-decoration: none;
    color: inherit;
  }

  .contact-links a {
    text-decoration: none;
    color: var(--text);
  }

  #contact-dialog-button {
    height: 1lh;
    color: var(--text);
    padding: 0;
  }

  .contact dialog {
    padding: 0;
    border: none;
    width: 100%;
    background: transparent;
  }

  .contact dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.6);
  }

  .contact-form {
    background-color: var(--background0);
  }

  .form-content {
    display: flex;
    gap: 1lh;
    padding: 0lh 1ch;
  }

  .form-container {
    display: flex;
    flex-direction: column;
    gap: 0.5lh 1ch;
    padding: 1lh 0.5ch 0lh;
  }

  .form-content input,
  .form-content textarea {
    width: 100%;
    background-color: var(--background0);
    resize: none;
  }

  .form-content textarea {
  }

  .form-buttons {
    display: flex;
    gap: 1ch;
    justify-content: flex-end;
  }

  main {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .content {
    padding: 0lh 1ch;
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--box-border-color) transparent;
  }
</style>
