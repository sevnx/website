---
import { getCollection } from 'astro:content';
import TuiLayout from '../layouts/TuiLayout.astro';
import DateBadge from '@/components/badges/DateBadge.astro';

export const name = 'Blog';

const blogs = await getCollection('blog');

const sorted = blogs.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
---

<TuiLayout name={name}>
  <div class="page">
    <h1># Some of my thoughts</h1>

    {
      sorted.length === 0 ? (
        <div class="empty-state">
          <p>Nothing here yet</p>
        </div>
      ) : (
        <div class="timeline">
          {sorted.map((blog) => (
            <div class="timeline-entry">
              <a href={`/blog/${blog.id}`}>[ {blog.data.title} ]</a>
              <span>-</span>
              <DateBadge date={blog.data.publishedDate} />
            </div>
          ))}
        </div>
      )
    }
  </div>
</TuiLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .empty-state {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .empty-state p {
    margin: 0;
  }

  .timeline {
    position: relative;
    padding-top: 1lh;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .timeline a {
    color: inherit;
    text-decoration: none;
  }


  .timeline-entry {
    position: relative;
    padding-left: 2ch;
    padding-bottom: 1lh;
  }

  /* Node marker — same color as the line */
  .timeline-entry::before {
    content: '*';
    position: absolute;
    left: 0;
    top: 0;
    line-height: 1lh;
  }

  /* Last entry: line extends to fill the rest of the scroll area */
  .timeline-entry:last-child {
    flex: 1;
  }
</style>
