---
import { getCollection } from 'astro:content';
import TuiLayout from '../../layouts/TuiLayout.astro';
import ProjectGrid from '@/components/projects/ProjectGrid.astro';
import SkillBadge from '@/components/badges/SkillBadge.astro';
import { technologies } from '@/data/technologies';

export async function getStaticPaths() {
  const projects = await getCollection('project');

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { Content } = await project.render();
const closeHref = `/projects#project-${project.slug}`;
const closeHandler = `if (history.length > 1) { history.back(); return false; }`;
---

<TuiLayout name="Projects">
  <h1># The cool things I have had the opportunity to work on</h1>
  <ProjectGrid projects={projects} />
  <a class="overlay-backdrop" href={closeHref} aria-label="Close project view" onclick={closeHandler}></a>
  <div class="overlay" role="dialog" aria-modal="true" aria-label={`Project details: ${project.data.name}`}>
    <div class="overlay-panel" box-="square">
      <div class="overlay-header">
        <h2>## {project.data.name}</h2>
        <a class="overlay-close" href={closeHref} box-="round" onclick={closeHandler}>Close</a>
      </div>
      <div class="overlay-summary" box-="square">
        <span>{project.data.shortDescription}</span>
      </div>
      <div class="overlay-technologies" box-="square">
        <div class="technology-list">
          {
            project.data.technologies.map((technology) => (
              <SkillBadge technology={technologies.find((t) => t.name === technology)} />
            ))
          }
        </div>
      </div>
      <div class="overlay-content" box-="square">
        <Content />
      </div>
      <div class="overlay-links">
        {
          project.data.websiteUrl && (
            <a href={project.data.websiteUrl} target="_blank" rel="noreferrer" box-="round">
              Website
            </a>
          )
        }
        {
          project.data.githubUrl && (
            <a href={project.data.githubUrl} target="_blank" rel="noreferrer" box-="round">
              GitHub
            </a>
          )
        }
      </div>
    </div>
  </div>
</TuiLayout>

<style>
  .overlay-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 10;
    cursor: pointer;
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 4ch 2ch;
    overflow: auto;
    pointer-events: none;
  }

  .overlay-panel {
    width: min(120ch, 100%);
    display: flex;
    flex-direction: column;
    gap: 1.5ch;
    padding: 2ch;
    pointer-events: auto;
  }

  .overlay-header {
    display: flex;
    justify-content: space-between;
    gap: 1ch;
    align-items: center;
  }

  .overlay-summary {
    text-align: center;
    padding: 1ch;
  }

  .overlay-technologies {
    padding: 1ch;
  }

  .overlay-content {
    padding: 1ch;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
    justify-content: center;
  }

  .overlay-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
    justify-content: flex-end;
  }

  .overlay-links a,
  .overlay-close {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    height: 1lh;
    padding: 0 1ch;
  }
</style>
