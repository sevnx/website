---
import { getCollection } from 'astro:content';
import TuiLayout from '../../layouts/TuiLayout.astro';
import ProjectGrid from '@/components/projects/ProjectGrid.astro';
import SkillBadge from '@/components/badges/SkillBadge.astro';
import { technologies } from '@/data/technologies';
import MarkdownContent from '@/components/ui/MarkdownContent.astro';

export async function getStaticPaths() {
  const projects = await getCollection('project');

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { Content } = await project.render();
const closeHref = `/projects`;

const statusStyles = {
  'In progress': { icon: '', color: '#F9E2AF', text: '#1B1B1B' },
  Completed: { icon: '', color: '#A6E3A1', text: '#1B1B1B' },
  'In production': { icon: '', color: '#89B4FA', text: '#1B1B1B' },
};

const projectTypeIcons = {
  Personal: '',
  Academic: '',
  Professional: '',
};

const applicationTypeIcons = {
  Web: '',
  Desktop: '',
  Mobile: '',
  CLI: '',
  TUI: '',
};

const statusStyle = statusStyles[project.data.status];
---

<TuiLayout name="Projects">
  <h1># The cool things I have had the opportunity to work on</h1>
  <ProjectGrid projects={projects} />
  <a class="dialog-backdrop" href={closeHref} aria-label="Close project view"></a>
  <dialog open aria-label={`Project details: ${project.data.name}`} class="project-dialog">
    <div class="project-dialog-panel" box-="square">
      <h1># {project.data.name}</h1>
      <table class="project-info-table">
        <tbody>
          <tr>
            <th scope="row">Description</th>
            <td>
              <span>{project.data.shortDescription}</span>
            </td>
          </tr>
          <tr>
            <th scope="row">Status</th>
            <td>
              <span is-="badge" style={`--badge-color: ${statusStyle.color}; --badge-text: ${statusStyle.text};`}>
                <span>{statusStyle.icon}&nbsp;{project.data.status}</span>
              </span>
            </td>
          </tr>
          <tr>
            <th scope="row">Project type</th>
            <td>
              <span is-="badge">
                <span>{projectTypeIcons[project.data.projectType]} {project.data.projectType}</span>
              </span>
            </td>
          </tr>
          <tr>
            <th scope="row">Application type</th>
            <td>
              <div class="badge-list">
                {
                  project.data.applicationType.map((type) => (
                    <span is-="badge">
                      <span>
                        {applicationTypeIcons[type]} {type}
                      </span>
                    </span>
                  ))
                }
              </div>
            </td>
          </tr>
          <tr>
            <th scope="row">Stack</th>
            <td>
              <div class="badge-list">
                {
                  project.data.stack.map((technology) => (
                    <SkillBadge technology={technologies.find((t) => t.name === technology)} />
                  ))
                }
              </div>
            </td>
          </tr>
          {
            project.data.tools && project.data.tools.length > 0 && (
              <tr>
                <th scope="row">Tools</th>
                <td>
                  <div class="badge-list">
                    {project.data.tools.map((technology) => (
                      <SkillBadge technology={technologies.find((t) => t.name === technology)} />
                    ))}
                  </div>
                </td>
              </tr>
            )
          }
        </tbody>
      </table>
      <MarkdownContent content={Content} />
    </div>
  </dialog>
</TuiLayout>

<style>
  .dialog-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 99;
    cursor: pointer;
  }

  .project-dialog {
    position: fixed;
    min-width: 60%;
    width: fit-content;
    height: auto;
    max-height: 90vh;
    z-index: 100;
  }

  .project-dialog-panel {
    display: flex;
    flex-direction: column;
    pointer-events: auto;
    padding: 1lh 2ch;
    overflow-y: auto;
  }

  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
  }
</style>
