---
import { getCollection } from 'astro:content';
import TuiLayout from '../../layouts/TuiLayout.astro';
import ProjectGrid from '@/components/projects/ProjectGrid.astro';
import SkillBadge from '@/components/badges/SkillBadge.astro';
import { technologies } from '@/data/technologies';
import MarkdownContent from '@/components/ui/MarkdownContent.astro';

export async function getStaticPaths() {
  const projects = await getCollection('project');

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
const { Content } = await project.render();
const closeHref = `/projects`;
---

<TuiLayout name="Projects">
  <h1># The cool things I have had the opportunity to work on</h1>
  <ProjectGrid projects={projects} />
  <a class="dialog-backdrop" href={closeHref} aria-label="Close project view"></a>
  <dialog open aria-label={`Project details: ${project.data.name}`} class="project-dialog">
    <div class="project-dialog-panel" box-="square">
      <h1># {project.data.name}</h1>
      <span>{project.data.shortDescription}</span>
      <div is-="separator"></div>
      <div class="technologies-section">
        <div class="technology-group">
          <h3>Stack</h3>
          <div class="technology-list">
            {
              project.data.stack.map((technology) => (
                <SkillBadge technology={technologies.find((t) => t.name === technology)} />
              ))
            }
          </div>
        </div>
        {
          project.data.tools && project.data.tools.length > 0 && (
            <div class="technology-group">
              <h3>Tools</h3>
              <div class="technology-list">
                {project.data.tools.map((technology) => (
                  <SkillBadge technology={technologies.find((t) => t.name === technology)} />
                ))}
              </div>
            </div>
          )
        }
      </div>
      <MarkdownContent content={Content} />
    </div>
  </dialog>
</TuiLayout>

<style>
  .dialog-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 99;
    cursor: pointer;
  }

  .project-dialog {
    position: fixed;
    min-width: 60%;
    z-index: 100;
  }

  .project-dialog-panel {
    display: flex;
    flex-direction: column;
    pointer-events: auto;
    padding: 1lh 2ch;
  }

  .project-dialog-header {
    display: flex;
    justify-content: space-between;
    gap: 1ch;
    align-items: center;
  }

  .project-dialog-summary {
    text-align: center;
    padding: 1ch;
  }

  .project-dialog-technologies {
    padding: 1ch;
  }

  .project-dialog-content {
    padding: 1ch;
  }

  .technologies-section {
    display: flex;
    flex-direction: column;
    gap: 2ch;
  }

  .technology-group h3 {
    text-align: center;
    margin-bottom: 1ch;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
    justify-content: center;
  }

  .project-dialog-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1ch;
    justify-content: flex-end;
  }

  .project-dialog-links a,
  .project-dialog-close {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    height: 1lh;
    padding: 0 1ch;
  }
</style>
