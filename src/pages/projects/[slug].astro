---
import { getCollection } from 'astro:content';
import { projectHref } from '@/lib/projects';

export async function getStaticPaths() {
  return (await getCollection('project', ({ data }) => data.locale === 'en')).map((project) => ({ params: { slug: project.data.key } }));
}

// Projects now open inside the portfolio; keep old links working.
return Astro.redirect(projectHref(Astro.params.slug!), 301);
---
