---
import { getCollection } from 'astro:content';
import TuiLayout from '../layouts/TuiLayout.astro';
import ProjectCard from '@/components/cards/ProjectCard.astro';

export const name = 'Projects';

const projects = await getCollection('project');
---

<TuiLayout name={name}>
  <h1># The things I've worked on</h1>

  <div class="projects">
    {
      projects.map((project) => (
        <div class="project">
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</TuiLayout>

<style>
  .projects {
    display: flex;
	align-items: stretch;
	flex-wrap: wrap;
	flex-direction: row;
    gap: 1ch;
  }

  .project {
	flex: 1 1 49%;
	max-width: 49%;
  }
</style>
